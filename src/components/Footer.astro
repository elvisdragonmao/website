---
import Icon from "./Icon.astro";
import Newsletter from "./Newsletter.astro";
import "../styles/ascii-footer.css";
import { getLocale, localizePath, t, type Locale } from "../i18n";
interface Props {
	compact?: boolean;
	newsletter?: boolean;
	ascii?: boolean;
	locale?: Locale;
}
const { compact = false, newsletter = false, ascii = false } = Astro.props;
const locale = Astro.props.locale ?? getLocale(Astro.url.pathname);
const studioLines = t(locale, "footer.studio").split("\n");
---

<footer class:list={["site-footer", { compact, "has-newsletter": newsletter, "ascii-footer": ascii }]}>
	<div class="footer-main">
		<div class="footer-note">
			<a class="footer-name" href={localizePath("/", locale)}>Elvis Mao.</a><a class="footer-studio" href="https://linyao.tw/" target="_blank" rel="noopener noreferrer">
				{
					studioLines.map((line, index) => (
						<>
							{index > 0 && <br />}
							{line}
						</>
					))
				}
				<Icon />
			</a>
		</div>
		<nav class="footer-socials" aria-label={t(locale, "footer.socials")}>
			<a href="mailto:info@elvismao.com" target="_blank" rel="noopener noreferrer"><Icon name="envelope" />{t(locale, "footer.email")}<span class="link-arrow" aria-hidden="true">↗</span></a>
			<a href="https://github.com/elvisdragonmao" target="_blank" rel="noopener noreferrer"><Icon name="github" />GitHub<span class="link-arrow" aria-hidden="true">↗</span></a>
			<a href="https://t.me/elvisdragonmao" target="_blank" rel="noopener noreferrer"><Icon name="telegram" />Telegram<span class="link-arrow" aria-hidden="true">↗</span></a>
			<a href="https://www.instagram.com/elvisdragonmao/" target="_blank" rel="noopener noreferrer"><Icon name="instagram" />Instagram<span class="link-arrow" aria-hidden="true">↗</span></a>
		</nav>
		{newsletter && <Newsletter locale={locale} />}
	</div>
	<div class="footer-fine">
		<span>© {new Date().getFullYear()} Elvis Dragon Mao</span><div class="footer-meta">
			<a href="https://github.com/elvisdragonmao/website" target="_blank" rel="noopener noreferrer">GitHub <span class="link-arrow" aria-hidden="true">↗</span></a><a
				href={localizePath("/colophon/", locale)}
			>
				{t(locale, "footer.credits")}
				<span class="link-arrow" aria-hidden="true">↗</span>
			</a>
		</div>
	</div>
</footer>
