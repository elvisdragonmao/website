---
interface Props {
	kind: "touch" | "code" | "type" | "hardware" | "motto" | "broadcast" | "contact";
}
const { kind } = Astro.props;
const fallback = {
	contact: " . . . . . . . . . . . . \n  : : : : : : : : : : : \n . . . . . . . . . . . . ",
	touch: "      .: .:::::. :.\n    .::           ::.\n   ::    .:::::.    ::\n    '::.         .::'\n       ':::::::'",
	code: " .----------------------.\n |      < / >           |\n |                  _   |\n '----------------------'\n        |      |\n     ---'------'---",
	type: "字",
	hardware: "      +--------+\n     /        /|\n    +--------+ |\n    |        | +\n    |        |/\n    +--------+",
	motto: "    .----.\n  /  / /  \\ \n (  (  )   )\n  \\  \\ /  /\n    '----'",
	broadcast: "  :    :    :    :    :\n  |   [=]   |    |    |\n [=]   |    |   [=]   |\n  |    |   [=]   |    |\n  |    |    |    |   [=]\n  ▁ ▄ ▃ ▆ ▂ ▅ ▇ ▄ ▂ ▃ ▁"
}[kind];
---

<div class:list={["about-art", `about-art-${kind}`]} data-about-art={kind} aria-hidden="true">
	<pre data-art-output>{fallback}</pre>
</div>
