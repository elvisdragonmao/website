---
import profile from "../assets/about/profile.webp";
import { defaultSocialImage, siteIdentity, type SocialImage } from "../data/seo";
import { availableLocalesForPath, getLocale, localizePath, stripLocalePath, t, type Locale } from "../i18n";
import { canonicalUrl, ogLocales, seoLabels, serializeStructuredData, structuredData, type SeoCollectionItem, type SeoProject } from "../lib/seo";

interface Props {
	title?: string;
	description?: string;
	locale?: Locale;
	image?: SocialImage;
	noindex?: boolean;
	project?: SeoProject;
	collection?: SeoCollectionItem[];
	/** Tools keep their actual document language and do not expose false alternates. */
	translated?: boolean;
}
const locale = Astro.props.locale ?? getLocale(Astro.url.pathname);
const { title = t(locale, "site.title"), description = t(locale, "site.description"), noindex = false, translated = true, project, collection } = Astro.props;
const image: SocialImage = Astro.props.image ?? { ...defaultSocialImage, alt: seoLabels[locale].image };
const site = Astro.site ?? new URL("https://elvismao.com");
const canonical = canonicalUrl(Astro.url.pathname, site);
const imageUrl = new URL(image.src, site).href;
const alternateLocales = translated && !noindex ? availableLocalesForPath(Astro.url.pathname) : [];
const graph = noindex
	? undefined
	: structuredData({ site, pathname: stripLocalePath(Astro.url.pathname), canonical, locale, title, description, image, profileImage: profile.src, project, collection });
---

<title>{title}</title>
<meta name="description" content={description} />
<meta name="author" content={siteIdentity.personName} />
<meta name="robots" content={noindex ? "noindex" : "index, follow, max-image-preview:large"} />
<link rel="canonical" href={canonical} />
{alternateLocales.length > 1 && alternateLocales.map(value => <link rel="alternate" hreflang={value} href={new URL(localizePath(Astro.url.pathname, value), site).href} />)}
{alternateLocales.length > 1 && <link rel="alternate" hreflang="x-default" href={new URL(localizePath(Astro.url.pathname, "en"), site).href} />}
<meta property="og:type" content="website" />
<meta property="og:site_name" content={siteIdentity.name} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:locale" content={ogLocales[locale]} />
{alternateLocales.filter(value => value !== locale).map(value => <meta property="og:locale:alternate" content={ogLocales[value]} />)}
<meta property="og:image" content={imageUrl} />
{imageUrl.startsWith("https:") && <meta property="og:image:secure_url" content={imageUrl} />}
{image.type && <meta property="og:image:type" content={image.type} />}
{image.width && <meta property="og:image:width" content={String(image.width)} />}
{image.height && <meta property="og:image:height" content={String(image.height)} />}
<meta property="og:image:alt" content={image.alt} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl} />
<meta name="twitter:image:alt" content={image.alt} />
{graph && <script type="application/ld+json" set:html={serializeStructuredData(graph)} />}
