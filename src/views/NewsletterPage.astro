---
import Layout from "../layouts/Layout.astro";
import Footer from "../components/Footer.astro";
import { getLocale, type Locale } from "../i18n";
import "../styles/newsletter.css";
import { newsletterCopy, newsletterFormAttributes } from "../i18n/newsletter";
interface Props {
	locale?: Locale;
}
const locale = Astro.props.locale ?? getLocale(Astro.url.pathname);
const copy = newsletterCopy[locale];
---

<Layout locale={locale} title={copy.title} description={copy.description}>
	<main id="main" class="letter-page">
		<h1>{copy.heading}</h1>
		<p class="letter-lead">{copy.intro}</p>
		<p>{copy.details}</p>
		<form data-newsletter {...newsletterFormAttributes(locale)} action="/api/newsletter/" method="post" novalidate data-astro-reload>
			<label for="letter-name">{copy.name}</label>
			<div class="letter-field" data-newsletter-field>
				<input id="letter-name" name="name" autocomplete="name" maxlength="120" placeholder={copy.namePlaceholder} aria-describedby="letter-status" />
			</div>
			<label for="letter-email">{copy.email}</label>
			<div class="letter-field" data-newsletter-field>
				<input id="letter-email" name="email" type="email" autocomplete="email" maxlength="254" required aria-describedby="letter-caption letter-status" />
			</div>
			<label for="letter-interest">{copy.interest}</label>
			<div class="letter-field" data-newsletter-field>
				<textarea id="letter-interest" name="interest" rows="3" maxlength="2000" placeholder={copy.interestPlaceholder} aria-describedby="letter-status"></textarea>
			</div>
			<button type="submit">{copy.subscribe}</button>
			<output id="letter-status" data-status role="status" aria-live="polite"></output>
		</form>
		<p id="letter-caption" class="letter-caption">{copy.caption}</p>
	</main>
	<Footer locale={locale} />
</Layout>
<style>
	.letter-page {
		width: min(38rem, calc(100% - 3rem));
		margin: 0 auto;
		padding: 10rem 0 6rem;
	}
	h1 {
		font-size: clamp(1.8rem, 6vw, 3rem);
		line-height: 1.25;
		margin-bottom: 2.5rem;
	}
	.letter-lead {
		font-size: 1.25rem;
		color: var(--ink);
	}
	p {
		line-height: 1.9;
		color: var(--muted);
	}
	form {
		display: grid;
		gap: 0.75rem;
		margin: 3rem 0 1.5rem;
	}
	label {
		margin-top: 1rem;
		font-size: 0.85rem;
	}
	input,
	textarea {
		width: 100%;
		padding: 0.8rem;
		border: 1px solid var(--line);
		background: #111514;
		color: var(--ink);
		font: inherit;
		border-radius: 0;
	}
	textarea {
		resize: vertical;
	}
	input:focus-visible,
	textarea:focus-visible {
		outline: 2px solid var(--ink);
		outline-offset: 3px;
	}
	button {
		justify-self: start;
		background: var(--ink);
		color: #080909;
		border: 1px solid var(--ink);
		padding: 0.85rem 1.5rem;
		margin-top: 1rem;
		font: inherit;
		cursor: pointer;
	}
	button:hover {
		background: #080909;
		color: var(--ink);
	}
	.letter-caption,
	output {
		font-size: 0.75rem;
		line-height: 1.7;
	}
</style>
