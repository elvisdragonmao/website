---
import { getCreditSections } from "../data/credits";
import { getLocale, type Locale } from "../i18n/index";
import { getCreditsCopy } from "../i18n/credits";
import Layout from "../layouts/Layout.astro";
import "../styles/credits.css";
interface Props {
	locale?: Locale;
}
const { locale = getLocale(Astro.url.pathname) } = Astro.props;
const copy = getCreditsCopy(locale);
const creditSections = getCreditSections(locale);
---

<Layout locale={locale} title={`${copy.title} — Elvis Dragon Mao`} description={copy.description}>
	<main id="main" class="credits-page">
		<canvas class="credits-static" data-credits-static aria-hidden="true"></canvas>
		<pre class="credits-interference" data-credits-interference aria-hidden="true"></pre>
		<div class="credits-stage" data-credits data-play={copy.play} data-pause={copy.pause} data-play-label={copy.playLabel} data-pause-label={copy.pauseLabel}>
			<header class="credits-heading">
				<h1>{copy.title}<span class="credit-ghost" aria-hidden="true">{copy.title}</span></h1>
				<pre aria-hidden="true">+ - - - - - - - - - - - - - +</pre>
			</header>
			<div class="credits-roll" data-credits-roll tabindex="0" role="region" aria-label={copy.region} data-lenis-prevent>
				<div class="credits-reel" data-credits-reel>
					{
						creditSections.map(section => (
							<section class="credits-section" aria-label={section.title}>
								<h2>{section.title}</h2>
								{section.entries.map(entry => (
									<div class="credit-entry">
										<p class="credit-name">
											{entry.href ? (
												<a href={entry.href} target="_blank" rel="noopener noreferrer">
													{entry.name}
												</a>
											) : (
												entry.name
											)}
											<span class="credit-ghost" aria-hidden="true">
												{entry.name}
											</span>
										</p>
										{entry.detail && <p class="credit-detail">{entry.detail}</p>}
										{entry.license && (
											<p class="credit-detail">
												<a href={entry.license.href} target="_blank" rel="noopener noreferrer">
													{entry.license.name}
												</a>
											</p>
										)}
									</div>
								))}
							</section>
						))
					}
				</div>
			</div>
			<button class="credits-toggle" type="button" data-credits-toggle aria-label={copy.pauseLabel} aria-pressed="false" hidden>{copy.pause}</button>
		</div>
	</main>
</Layout>
<script>
	import "../scripts/credits";
</script>
