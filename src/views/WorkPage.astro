---
import Layout from "../layouts/Layout.astro";
import Footer from "../components/Footer.astro";
import WorkCard from "../components/WorkCard.astro";
import { localizedWorkProjects, workCategories } from "../data/work";
import { workCopy } from "../i18n/work";
import type { Locale } from "../i18n";
import "../styles/work.css";

interface Props {
	locale: Locale;
}
const { locale } = Astro.props;
const copy = workCopy(locale);
const workProjects = localizedWorkProjects(locale);
const featured = workProjects.filter(project => project.featured);
const categories = workCategories
	.map(category => ({
		name: copy.categories[category],
		id: category,
		projects: workProjects.filter(project => !project.featured && project.category === category)
	}))
	.filter(category => category.projects.length);
const title = String.raw`  ____            _           _
 |  _ \ _ __ ___ (_) ___  ___| |_ ___
 | |_) | '__/ _ \| |/ _ \/ __| __/ __|
 |  __/| | | (_) | |  __/ (__| |_\__ \
 |_|   |_|  \___// |\___|\___|\__|___/
               |__/`;
---

<Layout locale={locale} title={copy.title} description={copy.description} collection={[...featured, ...categories.flatMap(category => category.projects)]}>
	<main id="main" class="page-main projects-page">
		<header class="projects-heading">
			<h1><span class="sr-only">{copy.heading}</span><pre aria-hidden="true">{title}</pre></h1>
			<p>{copy.intro[0]}<br />{copy.intro[1]}</p>
			<nav class="projects-index" aria-label={copy.categoriesLabel}>
				<a href="#featured">{copy.featured}</a>
				{categories.map(category => <a href={`#${category.id}`}>{category.name}</a>)}
			</nav>
		</header>
		<section class="work-featured" id="featured" aria-labelledby="featured-heading">
			<div class="work-section-heading"><h2 id="featured-heading">{copy.featured}</h2></div>
			<div class="work-featured-grid">{featured.map(project => <WorkCard project={project} locale={locale} featured />)}</div>
		</section>
		{
			categories.map(category => (
				<section class="work-collection" id={category.id} data-expanded="false" aria-labelledby={`${category.id}-heading`}>
					<div class="work-section-heading">
						<h2 id={`${category.id}-heading`}>{category.name}</h2>
						<button
							class="collection-toggle"
							type="button"
							aria-expanded="false"
							aria-controls={`${category.id}-grid`}
							data-label-expand={copy.showAll(category.projects.length)}
							data-label-collapse={copy.showLess}
						>
							{copy.showAll(category.projects.length)}
						</button>
					</div>
					<div class="work-collection-grid" id={`${category.id}-grid`}>
						{category.projects.map(project => (
							<WorkCard project={project} locale={locale} />
						))}
					</div>
				</section>
			))
		}
		<noscript>
			<style>
				.work-collection[data-expanded] .work-card:nth-child(n) {
					display: block;
				}
				.collection-toggle {
					display: none;
				}
			</style>
		</noscript>
		<div class="work-footer"><Footer locale={locale} newsletter ascii /></div>
	</main>
</Layout>
<script>
	import "../scripts/work";
</script>
