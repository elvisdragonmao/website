---
import Head from "@components/Head.astro";
---

<html lang="zh-Hant">
	<head>
		<Head locale="zh-Hant" title="線上螢幕錄影 | 毛哥EM的基地" description="在瀏覽器中錄製螢幕、視窗或分頁，停止錄製後即可下載影片，無需安裝額外軟體。" theme="#413c69" />
		<style is:global>
			/* color from https://colorhunt.co/palette/413c694a47a3709fb0a7c5eb */
			* {
				margin: 0;
				padding: 0;
				box-sizing: border-box;
				font-family: "Helvetica", "Arial", "LiHei Pro", "黑體-繁", "微軟正黑體", sans-serif;
			}

			body {
				background-color: #413c69;
				color: #a7c5eb;
				text-align: center;
				height: 100svh;
				overflow-x: hidden;
				font-family: "Helvetica", "Arial", "LiHei Pro", "黑體-繁", "微軟正黑體", sans-serif;
			}

			a {
				color: #a7c5eb;
			}

			h1 {
				font-size: 3rem;
			}

			p {
				font-size: 1.5rem;
			}

			button,
			#downloadLink {
				font-size: 1.5rem;
				padding: 1rem 2rem;
				border: none;
				border-radius: 0.5rem;
				background-color: #709fb0;
				color: #fff;
				cursor: pointer;
				margin: 1rem 0;
				cursor: pointer;
				text-decoration: none;
				display: block;
			}

			#downloadLink {
				margin-bottom: 1rem;
			}

			@keyframes pulse {
				0% {
					box-shadow: 0 0 5px #a7c5eb;
				}

				50% {
					box-shadow: 0 0 15px #a7c5eb;
				}

				100% {
					box-shadow: 0 0 5px #a7c5eb;
				}
			}

			button:disabled {
				background-color: #ccc;
				cursor: not-allowed;
			}

			video {
				width: 40rem;
				max-width: 90vw;
				border-radius: 0.5rem;
				box-shadow: rgba(100, 100, 111, 0.2) 0px 7px 29px 0px;
			}

			main {
				display: flex;
				flex-direction: column;
				justify-content: center;
				align-items: center;
				height: 100%;
			}
		</style>
	</head>
	<body>
		<main>
			<h1>線上螢幕錄影</h1>
			<p>免費 極簡 快速</p>
			<button id="recordBtn">開始錄製</button>
			<div id="videoContainer" style="display: none">
				<video id="recordedVideo" controls></video>
				<br />
				<a id="downloadLink" href="#" download>下載影片</a>
			</div>
			<footer><a href="/">毛哥EM</a>製作</footer>
		</main>

		<script is:inline>
			let recorder, stream, recordingUrl;
			const recordBtn = document.getElementById("recordBtn");
			const videoContainer = document.getElementById("videoContainer");
			const recordedVideo = document.getElementById("recordedVideo");
			const downloadLink = document.getElementById("downloadLink");
			const status = document.createElement("p");
			status.setAttribute("role", "status");
			recordBtn.after(status);
			function reset() {
				stream?.getTracks().forEach(track => track.stop());
				stream = null;
				recordBtn.disabled = false;
				recordBtn.textContent = "開始錄製";
				recordBtn.style.animation = "";
			}
			function stop() {
				if (recorder?.state === "recording") {
					recordBtn.disabled = true;
					recordBtn.textContent = "處理中...";
					recorder.stop();
				}
			}
			recordBtn.addEventListener("click", async () => {
				if (recorder?.state === "recording") {
					stop();
					return;
				}
				recordBtn.disabled = true;
				status.textContent = "";
				try {
					if (!navigator.mediaDevices?.getDisplayMedia || !window.MediaRecorder) throw new Error("這個瀏覽器不支援螢幕錄製，請使用最新版桌面瀏覽器。");
					stream = await navigator.mediaDevices.getDisplayMedia({ video: true, audio: true });
					const chunks = [];
					recorder = new MediaRecorder(stream);
					recorder.addEventListener("dataavailable", event => {
						if (event.data.size) chunks.push(event.data);
					});
					recorder.addEventListener("stop", () => {
						if (chunks.length) {
							if (recordingUrl) URL.revokeObjectURL(recordingUrl);
							const blob = new Blob(chunks, { type: recorder.mimeType || chunks[0].type });
							recordingUrl = URL.createObjectURL(blob);
							recordedVideo.src = recordingUrl;
							downloadLink.href = recordingUrl;
							downloadLink.download = blob.type.includes("mp4") ? "recording.mp4" : "recording.webm";
							videoContainer.style.display = "block";
						}
						reset();
					});
					recorder.addEventListener("error", () => {
						status.textContent = "錄製失敗，請重試。";
						stop();
						reset();
					});
					stream.getVideoTracks()[0].addEventListener("ended", stop);
					recorder.start();
					recordBtn.disabled = false;
					recordBtn.textContent = "停止錄製";
					recordBtn.style.animation = "pulse 1s infinite";
				} catch (error) {
					status.textContent = error.name === "NotAllowedError" ? "已取消分享或未授權螢幕錄製。可以再次點擊開始錄製。" : error.message || "無法開始錄製，請重試。";
					reset();
				}
			});
			window.addEventListener("pagehide", () => {
				stop();
				stream?.getTracks().forEach(track => track.stop());
				if (recordingUrl) URL.revokeObjectURL(recordingUrl);
			});
		</script>
	</body>
</html>
