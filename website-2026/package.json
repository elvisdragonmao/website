{
	"name": "elvismao-com",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "corepack pnpm run check && astro build",
		"character:export": "node scripts/export-character.mjs",
		"character:prepare": "node scripts/prepare-character.mjs",
		"check": "astro check",
		"deploy": "corepack pnpm run build && wrangler deploy",
		"deploy:check": "corepack pnpm run build && wrangler deploy --dry-run --outdir .wrangler/deploy",
		"dev": "astro dev --host 127.0.0.1",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"lint": "corepack pnpm run format:check",
		"preview": "astro preview --host 127.0.0.1"
	},
	"dependencies": {
		"@fontsource/ibm-plex-mono": "^5.3.0",
		"@phosphor-icons/core": "^2.1.1",
		"astro": "^7.4.8",
		"three": "^0.187.0"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.12",
		"@gltf-transform/core": "^4.5.1",
		"@gltf-transform/extensions": "^4.5.1",
		"@gltf-transform/functions": "^4.5.1",
		"@types/three": "^0.187.0",
		"meshoptimizer": "^1.3.0",
		"prettier": "^3.8.1",
		"prettier-plugin-astro": "^0.14.1",
		"prettier-plugin-organize-imports": "^4.3.0",
		"prettier-plugin-packagejson": "^3.0.2",
		"typescript": "~5.9.3",
		"wrangler": "^4.160.0"
	},
	"packageManager": "pnpm@12.18.0+sha512.9d7882d5dc82147ecfc4e062aa34834e0ad0296710a1837a1115ae012127d36b7109e321ac1598a1dd0a65597681b1e99917e12ed0d749eae91187943363beb3",
	"engines": {
		"node": ">=22.23.4"
	}
}
