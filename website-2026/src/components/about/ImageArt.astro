---
import profile from "../../assets/about/profile.webp";
import furry from "../../assets/about/furry.webp";
import porter from "../../assets/about/porter.webp";
import kendrick from "../../assets/about/kendrick.webp";
interface Props {
	kind: "portrait" | "furry" | "music";
}
const { kind } = Astro.props;
const images = kind === "music" ? [kendrick, porter] : [kind === "portrait" ? profile : furry];
---

<div class:list={["about-media", `media-${kind}`]} data-image-art={kind} aria-hidden="true">
	<div class="media-images">
		{
			images.map((image, i) => (
				<img src={image.src} width={image.width} height={image.height} alt="" class={kind === "music" ? (i === 0 ? "music-kendrick" : "music-porter") : undefined} decoding="async" />
			))
		}
	</div>
	<canvas data-image-output></canvas>
</div>
