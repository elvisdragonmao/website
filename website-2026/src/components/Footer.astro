---
import Icon from "./Icon.astro";
import Newsletter from "./Newsletter.astro";
interface Props {
	compact?: boolean;
	newsletter?: boolean;
}
const { compact = false, newsletter = false } = Astro.props;
---

<footer class:list={["site-footer", { compact, "has-newsletter": newsletter }]}>
	<div class="footer-main">
		<div class="footer-note">
			<a class="footer-name" href="/">Elvis Mao.</a><a class="footer-studio" href="https://linyao.tw/" target="_blank" rel="noopener noreferrer">
				For commissioned work in Taiwan,<br />visit LinYao Studio <Icon />
			</a>
		</div>
		<nav class="footer-socials" aria-label="Find Elvis Mao">
			<a href="mailto:info@elvismao.com" target="_blank" rel="noopener noreferrer"><Icon name="envelope" />Email</a>
			<a href="https://github.com/elvisdragonmao" target="_blank" rel="noopener noreferrer"><Icon name="github" />GitHub</a>
			<a href="https://t.me/elvisdragonmao" target="_blank" rel="noopener noreferrer"><Icon name="telegram" />Telegram</a>
			<a href="https://www.instagram.com/elvisdragonmao/" target="_blank" rel="noopener noreferrer"><Icon name="instagram" />Instagram</a>
		</nav>
		{newsletter && <Newsletter />}
	</div>
	<div class="footer-fine">
		<span>© {new Date().getFullYear()} Elvis Mao</span><div class="footer-meta">
			<a href="https://github.com/elvisdragonmao/website" target="_blank" rel="noopener noreferrer">GitHub ↗</a><a href="/colophon/">Credits ↗</a>
		</div>
	</div>
</footer>
