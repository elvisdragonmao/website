---
import type { WorkProject } from "../data/work";
import { workBoxFrame } from "../lib/work-box";

interface Props {
	project: WorkProject;
	featured?: boolean;
}
const { project, featured = false } = Astro.props;
const frame = featured ? workBoxFrame(48, 30) : [];
---

<article class:list={["work-card", { "work-card-featured": featured, "work-card-text": !project.image }]} data-work-id={project.id} data-work-cube={featured ? "" : undefined}>
	{
		featured && (
			<svg class="work-cube-outline" viewBox="0 0 384 480" preserveAspectRatio="none" aria-hidden="true" focusable="false">
				{frame.map((row, y) => (
					<text x="0" y={y * 16 + 12} xml:space="preserve">
						{row}
					</text>
				))}
			</svg>
		)
	}
	<div class="work-card-content">
		<div class="work-card-media" aria-hidden="true">
			{project.image && <img src={project.image.src} width={project.image.width} height={project.image.height} alt="" loading="lazy" decoding="async" />}
		</div>
		<div class="work-card-copy">
			<h3>{project.title}</h3>
			<p>{project.description}</p>
			<div class="work-card-links">
				{
					project.projectUrl && (
						<a class="work-card-primary" href={project.projectUrl} target="_blank" rel="noopener noreferrer" aria-label={`View ${project.title}`}>
							View{" "}
							<span class="link-arrow" aria-hidden="true">
								↗
							</span>
						</a>
					)
				}
				{
					project.codeUrl && (
						<a class:list={[{ "work-card-primary": !project.projectUrl }]} href={project.codeUrl} target="_blank" rel="noopener noreferrer" aria-label={`${project.title} code`}>
							Code{" "}
							<span class="link-arrow" aria-hidden="true">
								↗
							</span>
						</a>
					)
				}
			</div>
		</div>
	</div>
</article>
