---
import "../styles/scene-loader.css";
---

<section class="scene-loader" data-scene-loader role="status" aria-label="Preparing the interactive scene" aria-live="polite">
	<div class="scene-loader-content">
		<span class="scene-loader-signature">EM / a small world, loading.</span>
		<pre data-loader-art aria-hidden="true">[░░░░░░░░░░░░░░░░░░░░]</pre>
		<p data-loader-label>Preparing the glyphs…</p>
		<span class="scene-loader-footnote">Please give the dragon a moment.</span>
	</div>
</section>
