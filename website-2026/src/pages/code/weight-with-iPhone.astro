---
import Head from "@components/Head.astro";
---

<html lang="zh-Hant">
	<head>
		<Head path="weight-with-iPhone" title="iPhone 3D Touch觸控秤 | 毛哥EM的基地" description="使用支援 3D Touch 的 iPhone 讀取觸控壓力的實驗。" theme="#FFF" />
		<style is:global>
			* {
				-webkit-user-select: none;
			}

			body,
			html {
				margin: 0;
				padding: 0;
			}

			#container {
				width: 100%;
				max-width: 415px;
				height: 100%;
				margin: 0 auto;
				position: relative;
				box-sizing: border-box;
				max-height: 800px;
			}

			#footer {
				width: 100%;
				height: 130px;
				background: linear-gradient(90deg, #fc00ff, #00dbde);
				position: absolute;
				bottom: 0;
				border-radius: 10px;
			}

			#controls {
				width: 100%;
				height: 50px;
				position: absolute;
				background: rgba(0, 0, 0, 0.4);
				bottom: 0;
			}

			#weight {
				width: 100%;
				height: 75px;
				text-align: center;
				font-size: 52px;
				color: #fff;
				line-height: 75px;
				top: 0;
				position: absolute;
			}

			#tare {
				background: rgba(0, 0, 0, 0.4);
				color: #fff;
				text-align: center;
				width: 50%;
				font-size: 24px;
				line-height: 50px;
				height: 50px;
				left: 0;
			}

			select {
				width: 40%;
				position: absolute;
				right: 20px;
				height: 25px;
				-webkit-appearance: none;
				bottom: 5px;
				display: block;
				padding-right: 15px;
				border: none;
				outline: 0;
				border-radius: 5px;
				font-weight: 700;
				font-size: 14px;
				padding: 0 5px;
			}

			#label {
				position: absolute;
				left: 50%;
				font-size: 12px;
				width: 50%;
				top: 0;
				text-align: center;
				top: 4px;
				color: #fff;
			}

			a,
			a:active,
			a:hover,
			a:visited {
				color: #fff;
			}

			#logo {
				height: 30px;
				width: 150px;
				text-align: center;
				line-height: 30px;
				border-bottom-left-radius: 5px;
				border-bottom-right-radius: 5px;
				position: absolute;
				top: 0;
				left: 0;
				right: 0;
				margin: auto;
				color: #fff;
				background: linear-gradient(90deg, #fc00ff, #00dbde);
			}

			#circle {
				width: 350px;
				bottom: 145px;
				position: absolute;
				top: 35px;
				left: 0;
				right: 0;
				margin: auto;
				border: 4px dashed #ddd;
			}

			#circle2 {
				position: absolute;
				border-radius: 50%;
				background: #f8e14b;
				top: 0;
				left: 0;
				right: 0;
				bottom: 0;
				margin: auto;
				width: 0;
				height: 0;
			}

			#message {
				height: 100px;
				width: 320px;
				text-align: center;
				position: absolute;
				top: 0;
				left: 0;
				bottom: 0;
				right: 0;
				margin: auto;
				font-size: 12px;
				color: #777;
			}

			#shortcutor {
				height: 30px;
				text-align: center;
				line-height: 30px;
				position: absolute;
				top: 0;
				left: 0;
				right: 0;
				margin: auto;
				color: #fff;
				background: linear-gradient(90deg, #fc00ff, #fc00ff);
			}

			@keyframes fade {
				from {
					opacity: 0;
				}

				to {
					opacity: 1;
				}
			}

			#warning {
				position: absolute;
				width: 100%;
				height: 40px;
				color: #8b0000;
				font-weight: 700;
				text-align: center;
				bottom: 5px;
				left: 0;
				right: 0;
				margin: auto;
				display: none;
				-webkit-animation: fade ease-in-out 0.5s;
			}

			html,
			body {
				min-height: 100svh;
				background: #fff;
				font-family:
					system-ui,
					-apple-system,
					sans-serif;
			}
			#container {
				width: min(415px, 100%);
				height: min(760px, calc(100svh - 32px));
				min-height: 480px;
				margin: 16px auto;
			}
			#circle {
				width: min(350px, calc(100% - 32px));
				touch-action: none;
				border-radius: 12px;
				overflow: hidden;
			}
			#circle2 {
				max-width: 95%;
				max-height: 95%;
				opacity: 0.35;
				pointer-events: none;
			}
			#message {
				width: calc(100% - 32px);
				height: auto;
				display: flex;
				flex-direction: column;
				justify-content: center;
				gap: 8px;
				line-height: 1.7;
				z-index: 1;
			}
			#message p {
				margin: 0;
			}
			#status {
				color: #68707d;
				font-size: 12px;
			}
			#tare {
				border: 0;
				padding: 0;
				font: inherit;
				font-size: 24px;
				cursor: pointer;
			}
			#sense:focus-visible,
			#tare:focus-visible {
				outline: 3px solid #5355be;
				outline-offset: -3px;
			}
			#weight {
				font-variant-numeric: tabular-nums;
			}
		</style>
	</head>
	<body>
		<div id="container">
			<div id="logo">3D 觸控秤</div>
			<div id="circle">
				<div id="message">
					<p><strong>iPhone 3D Touch 觸控壓力實驗</strong></p>
					<p>需要支援 3D Touch 的 iPhone 與 Safari。<br />一般觸控或桌面裝置無法量測重量。</p>
					<p>放置導電物體時，避免尖銳或可能刮傷螢幕的表面。<br />這是壓力換算實驗，不能取代電子秤。</p>
					<p id="status" role="status" aria-live="polite">尚未偵測到壓力。</p>
				</div>
				<div id="circle2"></div>
				<div id="warning" style="display: none">
					Multi-Touch Weighing<br />
					(usually less accurate)
				</div>
			</div>
			<div id="footer">
				<div id="weight">0.00g</div>
				<div id="controls">
					<button id="tare" type="button">歸零</button>
					<select id="sense" aria-label="3D Touch 靈敏度">
						<option value="0">輕</option>
						<option value="1" selected>中等</option>
						<option value="2">重</option>
					</select>
					<div id="label">3D Touch靈敏度</div>
				</div>
			</div>
		</div>
		<script is:inline>
			(() => {
				const circle = document.getElementById("circle");
				const circle2 = document.getElementById("circle2");
				const weight = document.getElementById("weight");
				const warning = document.getElementById("warning");
				const status = document.getElementById("status");
				const sense = document.getElementById("sense");
				const conversions = [0.8, 1, 1.2];
				const touches = new Map();
				let tareForce = 0;
				let forceEventsSeen = false;
				let frame = 0;
				try {
					const stored = Number(localStorage.getItem("em-3d-touch-sensitivity") ?? 1);
					if (Number.isInteger(stored) && stored >= 0 && stored <= 2) sense.value = String(stored);
				} catch {}
				const clampForce = value => (Number.isFinite(value) ? Math.max(0, Math.min(1, value)) : 0);
				const hasForceSupport = () => forceEventsSeen || "ontouchforcechange" in window;
				const currentForce = () => (hasForceSupport() ? [...touches.values()].reduce((sum, value) => sum + value, 0) : 0);
				function render() {
					frame = 0;
					const force = currentForce();
					const average = touches.size ? clampForce(force / touches.size) : 0;
					const delta = Math.max(0, force - tareForce);
					const conversion = conversions[Number(sense.value)] ?? 1;
					let grams = delta > 0 ? (405.257 * delta + 2.056) * conversion : 0;
					if (grams < 12 && delta > 0) grams -= 2.056 * conversion;
					weight.textContent = `${Math.max(0, grams).toFixed(2)}g`;
					circle2.style.width = `${average * Math.min(345, circle.clientWidth)}px`;
					circle2.style.height = circle2.style.width;
					warning.style.display = touches.size > 1 ? "block" : "none";
					status.textContent = force > 0 ? "正在讀取 3D Touch 壓力。" : "尚未偵測到壓力。";
				}
				function scheduleRender() {
					if (!frame) frame = requestAnimationFrame(render);
				}
				function readTouches(event) {
					if (event.cancelable) event.preventDefault();
					if (event.type === "touchforcechange") forceEventsSeen = true;
					touches.clear();
					for (const touch of Array.from(event.touches || [])) touches.set(touch.identifier, clampForce(Number(touch.force)));
					scheduleRender();
				}
				for (const type of ["touchstart", "touchmove", "touchforcechange", "touchend", "touchcancel"]) circle.addEventListener(type, readTouches, { passive: false });
				document.getElementById("tare").addEventListener("click", () => {
					tareForce = currentForce();
					scheduleRender();
				});
				sense.addEventListener("change", () => {
					try {
						localStorage.setItem("em-3d-touch-sensitivity", sense.value);
					} catch {}
					scheduleRender();
				});
				window.addEventListener("blur", () => {
					touches.clear();
					scheduleRender();
				});
				render();
			})();
		</script>
	</body>
</html>
