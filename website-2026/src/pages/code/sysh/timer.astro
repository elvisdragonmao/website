---
import Head from "@components/Head.astro";
---

<html lang="zh-Hant">
	<head>
		<Head path="code/sysh/timer/" title="顏色倒數計時器 | 毛哥EM的基地" />
		<style is:global>
			body {
				display: flex;
				justify-content: center;
				align-items: center;
				min-height: 100svh;
				text-align: center;
				font-family:
					system-ui,
					-apple-system,
					BlinkMacSystemFont,
					"Segoe UI",
					Roboto,
					Oxygen,
					Ubuntu,
					Cantarell,
					"Open Sans",
					"Helvetica Neue",
					sans-serif;
			}
		</style>
	</head>
	<body>
		<main>
			<h1>顏色倒數計時器</h1>
			<label for="target-time">目標時間</label>
			<input type="datetime-local" id="target-time" />
			<button id="calculate-button">開始</button>
			<p>當背景變回紅色時時間到</p>
            <p id="time-difference" role="status"></p>
			<footer>毛哥EM製作</footer>
		</main>

		<script is:inline>
			const targetTimeInput = document.getElementById("target-time");
			const calculateButton = document.getElementById("calculate-button");
			const timeDifferenceText = document.getElementById("time-difference");

            let timer;
            calculateButton.addEventListener("click", () => {
                const targetTime = new Date(targetTimeInput.value).getTime();
                const duration = targetTime - Date.now();
                if (!Number.isFinite(targetTime) || duration <= 0) {
                    timeDifferenceText.textContent = "請選擇未來的時間。";
                    return;
                }
                clearInterval(timer);
                const updateDisplay = () => {
                    const remaining = Math.max(0, targetTime - Date.now());
                    const progress = Math.min(1, 1 - remaining / duration);
                    document.body.style.backgroundColor = `hsl(${progress * 360}, 50%, 50%)`;
                    timeDifferenceText.textContent = remaining ? `剩餘 ${Math.ceil(remaining / 1000)} 秒` : "時間到！";
                    if (!remaining) clearInterval(timer);
                };
                updateDisplay();
                timer = setInterval(updateDisplay, 500);
            });
            window.addEventListener("pagehide", () => clearInterval(timer));
		</script>
	</body>
</html>
