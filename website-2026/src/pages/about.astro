---
import Layout from "../layouts/Layout.astro";
import AsciiArt from "../components/about/AsciiArt.astro";
import ImageArt from "../components/about/ImageArt.astro";
import Footer from "../components/Footer.astro";
import PeopleField from "../components/about/PeopleField.astro";
import TechMarquee from "../components/about/TechMarquee.astro";
import ContactBlue from "../components/about/ContactBlue.astro";
import "@fontsource/ibm-plex-mono/500-italic.css";
import TalksMonitor from "../components/about/TalksMonitor.astro";
import { experiences, researchInterests, awards, otherRecognition } from "../data/about";
import "../styles/about.css";
import "../styles/about-tui.css";
import "../styles/about-media.css";
import "../styles/about-apps.css";
import "../styles/about-people.css";
import "../styles/about-type.css";
import "../styles/about-contact.css";
import "../styles/about-reveal.css";
---

<Layout title="Elvis Dragon Mao." description="Developer · Designer · Researcher · Debater">
	<main id="main" class="about-page" data-about-theme="btop">
		<header class="about-hero">
			<div class="about-identity">
				<h1>Elvis Dragon Mao.</h1>
				<p class="about-alias">a.k.a. 毛哥 EM, EM, Elvis Mao.</p>
				<p class="about-roles">Developer · Designer · Researcher · Debater</p>
				<div class="about-profile-links">
					<a href="https://resume.elvismao.com/" target="_blank" rel="noopener noreferrer">resume ↗</a>
					<a href="https://emtech.cc/p/now/" target="_blank" rel="noopener noreferrer">/now ↗</a>
				</div>
			</div>
			<ImageArt kind="portrait" />
		</header>

		<div class="about-facets about-workspace">
			<section class="about-facet tui-panel facet-touch">
				<div>
					<h2>Touch, I need something more.</h2>
					<p>HCI researcher exploring new ways for people and technology to connect. Through movement, touch, and interfaces that go beyond the screen.</p>
					<a class="about-link" href="#research">Explore my research ↗</a>
				</div>
				<AsciiArt kind="touch" />
			</section>
			<section class="about-facet tui-panel facet-furry">
				<ImageArt kind="furry" />
				<h2>Eww! Furry!</h2>
				<p>I'm a <a href="https://emtech.cc/p/furry-intro/" target="_blank" rel="noopener noreferrer">furry</a>. I love this wonderfully creative and welcoming community.</p>
			</section>
			<section class="about-facet tui-panel facet-stack">
				<TechMarquee />
				<h2>Full-Stack Dragon.</h2>
				<p>I build complex systems and stunning web experiences.</p>
				<a class="about-link" href="/work/">Explore my work ↗</a>
			</section>
			<section class="about-facet tui-panel facet-source">
				<AsciiArt kind="type" />
				<h2>❤️ Open Source.</h2>
				<p>Creator of <strong>emfont</strong>, an open-source CJK webfont service.</p>
				<p class="about-font-metric">1.2M+ requests/day.</p>
				<a class="about-link" href="https://font.emtech.cc/" target="_blank" rel="noopener noreferrer">emfont ↗</a>
				<a class="about-link source-github" href="https://github.com/elvisdragonmao/emfont" target="_blank" rel="noopener noreferrer">View on GitHub ↗</a>
			</section>
			<section class="about-facet tui-panel facet-music">
				<ImageArt kind="music" />
				<h2>EDM / Hip-Hop</h2>
				<div class="facet-caption">
					<p>Porter Robinson, Skrillex, Kendrick Lamar, and a lot more.</p><a class="about-link" href="https://www.last.fm/user/elvisdragonmao" target="_blank" rel="noopener noreferrer">Last.fm ↗</a>
				</div>
			</section>
			<section class="about-facet tui-panel facet-hardware">
				<AsciiArt kind="hardware" />
				<h2>Embedded / IoT / 3D Design</h2>
				<p>Love working with Arduino, sensors, and anything I can solder together.</p>
			</section>
			<section class="about-facet tui-panel facet-motto">
				<AsciiArt kind="motto" />
				<h2>motto</h2>
				<canvas class="motto-type" data-motto-type aria-hidden="true"></canvas>
				<p class="motto-copy"><span>Because It's</span><span>Absurd,</span><span>I Believe.</span></p>
			</section>
			<section class="about-facet tui-panel facet-camera">
				<PeopleField />
				<h2>I Shoot People.</h2>
				<p>With cameras, capture every touching moment.</p>
			</section>
			<section class="about-facet tui-panel facet-debate">
				<ImageArt kind="debate" />
				<h2>I argue with people.</h2>
				<p>Public Forum debate instructor and adjudicator. Also done Policy, WS, BP, and Extemp.</p>
			</section>
			<section class="about-facet tui-panel facet-broadcast">
				<AsciiArt kind="broadcast" />
				<h2>Behind the Screens.</h2>
				<p>I do PA and live broadcasting for event I love.</p>
			</section>

			<section class="about-statement terminal-window tui-panel" data-typing-terminal>
				<div class="terminal-window-controls" aria-hidden="true"><i></i><i></i><i></i></div>
				<p>
					<span class="terminal-line"><span class="terminal-source">When I learned to truly love myself,</span></span>
					<span class="terminal-line"><span class="terminal-source">I stopped chasing grand futures.</span></span>
					<span class="terminal-line"><span class="terminal-source">I simply do what I love, my way, at my own rhythm.</span></span>
				</p>
			</section>

			<section class="about-section tui-panel about-experience" aria-labelledby="experience-title">
				<div class="about-section-heading">
					<h2 id="experience-title">Experience</h2>
					<a class="about-link" href="https://resume.elvismao.com/" target="_blank" rel="noopener noreferrer">Full CV ↗</a>
				</div>
				<ol class="about-experience-list">
					{
						experiences.map(item => (
							<li>
								<span class="experience-years">{item.years}</span>
								<span class="experience-role">
									{item.role}
									{item.organization && <span class="experience-organization"> — {item.organization}</span>}
								</span>
							</li>
						))
					}
				</ol>
			</section>

			<section id="research" class="about-section tui-panel about-research" aria-labelledby="research-title">
				<h2 id="research-title">Selected Research</h2>
				<p class="research-interests">{researchInterests}</p>
				<article class="research-publication">
					<h3><a href="/work/omniobserve/">OmniObserve: Revealing Hidden Consensus in Online Meetings</a></h3>
					<p>Shih-Kai Hong, Ethel Yu-Tsen Hsiao, Yi-Jie Chen, Jason Zhi-Jun Chang, <strong>Elvis Dragon Mao</strong>, and Grace Yu-Chun Yen.</p>
					<p class="research-venue">TAICHI 2026 · Poster</p>
				</article>
				<div class="research-current">
					<h3>Current Research</h3>
					<ul>
						<li>AI Assistance for Police Workflows (ft. Hsinchu Criminal Investigation Corps)</li>
						<li>Fursuit Identity Retrieval and Recognition from 2D Images</li>
					</ul>
				</div>
			</section>

			<TalksMonitor />

			<section class="about-section tui-panel about-awards" aria-labelledby="awards-title">
				<h2 id="awards-title">Honors &amp; Awards</h2>
				<div class="awards-groups">
					{
						awards.map(group => (
							<details class="awards-year" open>
								<summary>
									{group.year}
									<span class="award-count">{group.items.length}</span>
								</summary>
								<ul>
									{group.items.map(item => (
										<li>
											<strong>{item.title}</strong>
											{item.context && (
												<span>
													{" "}
													— {item.context}
													{"project" in item && (
														<>
															{" "}
															<em>{item.project}</em>
														</>
													)}
												</span>
											)}
										</li>
									))}
								</ul>
							</details>
						))
					}
					<details class="awards-year" open>
						<summary>Other Web Design Awards<span class="award-count">{otherRecognition.length}</span></summary>
						<ul>{otherRecognition.map(item => <li>{item}</li>)}</ul>
					</details>
				</div>
			</section>

			<ContactBlue />
			<Footer newsletter ascii />
		</div>
	</main>
</Layout>

<script>
	import "../scripts/about";
</script>
