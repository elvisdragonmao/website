---
import Layout from "../layouts/Layout.astro";
import AsciiArt from "../components/about/AsciiArt.astro";
import TalksMonitor from "../components/about/TalksMonitor.astro";
import { experiences, researchInterests, awards, otherRecognition } from "../data/about";
import "../styles/about.css";
---

<Layout title="Elvis Dragon Mao." description="Developer · Designer · Researcher · Debater">
	<main id="main" class="about-page">
		<header class="about-hero">
			<div class="about-identity">
				<h1>Elvis Dragon Mao.</h1>
				<p class="about-alias">a.k.a. 毛哥 EM, EM, Elvis Mao.</p>
				<p class="about-roles">Developer · Designer · Researcher · Debater</p>
				<div class="about-profile-links">
					<a href="https://resume.elvismao.com/" target="_blank" rel="noopener noreferrer">resume ↗</a>
					<a href="https://emtech.cc/p/now/" target="_blank" rel="noopener noreferrer">/now ↗</a>
				</div>
			</div>
			<AsciiArt kind="portrait" />
		</header>

		<div class="about-facets">
			<section class="about-facet facet-touch">
				<div>
					<h2>Touch, I need something more.</h2>
					<p>Exploring new ways for people and technology to connect. Through movement, touch, and interfaces that go beyond the screen.</p>
					<a class="about-link" href="#research">Explore my research ↗</a>
				</div>
				<AsciiArt kind="touch" />
			</section>
			<section class="about-facet facet-furry">
				<AsciiArt kind="paws" />
				<h2>Eww! Furry!</h2>
				<p>I'm a furry. I love this wonderfully creative and welcoming community.</p>
			</section>
			<section class="about-facet facet-stack">
				<AsciiArt kind="code" />
				<h2>Full-Stack Dragon.</h2>
				<p>I build complex systems and stunning web experiences.</p>
				<a class="about-link" href="/work/">Explore my work ↗</a>
			</section>
			<section class="about-facet facet-source">
				<h2>❤️ Open Source.</h2>
				<p>Creator of <strong>emfont</strong>, an open-source CJK webfont service.</p>
				<p class="about-font-metric"><span>1.2M+</span> requests/day.</p>
				<a class="about-link" href="https://font.emtech.cc/" target="_blank" rel="noopener noreferrer">emfont ↗</a>
			</section>
			<section class="about-facet facet-debate">
				<h2>I argue with people.</h2>
				<p>Public Forum debate instructor and adjudicator. Also done Policy, WS, BP, and Extemp.</p>
			</section>
			<section class="about-facet facet-music">
				<AsciiArt kind="music" />
				<h2>EDM / Hip-Hop</h2>
				<p>Porter Robinson, Skrillex, Kendrick Lamar, and a lot more.</p>
			</section>
			<section class="about-facet facet-hardware">
				<AsciiArt kind="hardware" />
				<h2>Embedded / IoT / 3D Design</h2>
				<p>Love working with Arduino, sensors, and anything I can solder together.</p>
			</section>
			<section class="about-facet facet-camera">
				<AsciiArt kind="camera" />
				<h2>I Shoot People.</h2>
				<p>With cameras, capture every touching moment.</p>
			</section>
			<section class="about-facet facet-broadcast">
				<AsciiArt kind="broadcast" />
				<h2>Behind the Scenes.</h2>
				<p>I do PA and live broadcasting for event I love.</p>
			</section>
		</div>

		<section class="about-statement">
			<p>
				<span>When I learned to truly love myself,</span>
				<span>I stopped chasing grand futures.</span>
				<span>I simply do what I love, my way, at my own rhythm.</span>
			</p>
		</section>

		<section class="about-section about-experience" aria-labelledby="experience-title">
			<div class="about-section-heading">
				<h2 id="experience-title">Experience</h2>
				<a class="about-link" href="https://resume.elvismao.com/" target="_blank" rel="noopener noreferrer">Full CV ↗</a>
			</div>
			<ol class="about-experience-list">
				{
					experiences.map(item => (
						<li>
							<span class="experience-years">{item.years}</span>
							<span>
								{item.role}
								{item.organization && <span class="experience-organization"> — {item.organization}</span>}
							</span>
						</li>
					))
				}
			</ol>
		</section>

		<section id="research" class="about-section about-research" aria-labelledby="research-title">
			<h2 id="research-title">Selected Research</h2>
			<p class="research-interests">{researchInterests}</p>
			<article class="research-publication">
				<h3><a href="/work/omniobserve/">OmniObserve: Revealing Hidden Consensus in Online Meetings</a></h3>
				<p>Shih-Kai Hong, Ethel Yu-Tsen Hsiao, Yi-Jie Chen, Jason Zhi-Jun Chang, <strong>Elvis Dragon Mao</strong>, and Grace Yu-Chun Yen.</p>
				<p class="research-venue">TAICHI 2026 · Poster</p>
			</article>
			<div class="research-current">
				<h3>Current Research</h3>
				<ul>
					<li>AI Assistance for Police Workflows (ft. Hsinchu Criminal Investigation Corps)</li>
					<li>Fursuit Identity Retrieval and Recognition from 2D Images</li>
				</ul>
			</div>
		</section>

		<TalksMonitor />

		<section class="about-section about-awards" aria-labelledby="awards-title">
			<h2 id="awards-title">Honors &amp; Awards</h2>
			<div class="awards-groups">
				{
					awards.map(group => (
						<section class="awards-year">
							<h3>{group.year}</h3>
							<ul>
								{group.items.map(item => (
									<li>
										<strong>{item.title}</strong>
										{item.context && (
											<span>
												{" "}
												— {item.context}
												{"project" in item && (
													<>
														{" "}
														<em>{item.project}</em>
													</>
												)}
											</span>
										)}
									</li>
								))}
							</ul>
						</section>
					))
				}
				<section class="awards-year">
					<h3>Other Recognition</h3>
					<ul>{otherRecognition.map(item => <li>{item}</li>)}</ul>
				</section>
			</div>
		</section>

		<section class="about-contact" aria-labelledby="contact-title">
			<h2 id="contact-title">What's up bro!</h2>
			<p class="contact-verse">--2 Samuel 20:9</p>
			<p>Feel free to reach out for research, commission, or just to say hi!</p>
			<a href="mailto:info@elvismao.com" target="_blank" rel="noopener noreferrer">info@elvismao.com</a>
		</section>
	</main>
</Layout>

<script>
	import "../scripts/about";
</script>
