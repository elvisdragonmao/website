---
import { creditSections } from "../data/credits";
import Layout from "../layouts/Layout.astro";
import "../styles/credits.css";
---

<Layout title="Acknowledgements — Elvis Dragon Mao" description="The people, artwork and tools behind Elvis Mao’s website.">
	<main id="main" class="credits-page">
		<canvas class="credits-static" data-credits-static aria-hidden="true"></canvas>
		<pre class="credits-interference" data-credits-interference aria-hidden="true"></pre>
		<div class="credits-stage" data-credits>
			<header class="credits-heading">
				<h1>Acknowledgements<span class="credit-ghost" aria-hidden="true">Acknowledgements</span></h1>
				<pre aria-hidden="true">+ - - - - - - - - - - - - - +</pre>
			</header>
			<div class="credits-roll" data-credits-roll tabindex="0" role="region" aria-label="Acknowledgements. Scroll to read the credits." data-lenis-prevent>
				<div class="credits-reel" data-credits-reel>
					{
						creditSections.map(section => (
							<section class="credits-section" aria-label={section.title}>
								<h2>{section.title}</h2>
								{section.entries.map(entry => (
									<div class="credit-entry">
										<p class="credit-name">
											{entry.href ? (
												<a href={entry.href} target="_blank" rel="noopener noreferrer">
													{entry.name}
												</a>
											) : (
												entry.name
											)}
											<span class="credit-ghost" aria-hidden="true">
												{entry.name}
											</span>
										</p>
										{entry.detail && <p class="credit-detail">{entry.detail}</p>}
										{entry.license && (
											<p class="credit-detail">
												<a href={entry.license.href} target="_blank" rel="noopener noreferrer">
													{entry.license.name}
												</a>
											</p>
										)}
									</div>
								))}
							</section>
						))
					}
				</div>
			</div>
			<button class="credits-toggle" type="button" data-credits-toggle aria-label="Pause automatic credits" aria-pressed="false" hidden>[pause]</button>
		</div>
	</main>
</Layout>
<script>
	import "../scripts/credits";
</script>
