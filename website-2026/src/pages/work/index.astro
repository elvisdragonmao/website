---
import Layout from "../../layouts/Layout.astro";
import Footer from "../../components/Footer.astro";
import WorkCard from "../../components/WorkCard.astro";
import { workProjects, workCategories } from "../../data/work";
import "../../styles/work.css";

const featured = workProjects.filter(project => project.featured);
const categories = workCategories
	.map(category => ({
		name: category,
		id: category.toLowerCase(),
		projects: workProjects.filter(project => !project.featured && project.category === category)
	}))
	.filter(category => category.projects.length);
const title = String.raw`  ____            _           _
 |  _ \ _ __ ___ (_) ___  ___| |_ ___
 | |_) | '__/ _ \| |/ _ \/ __| __/ __|
 |  __/| | | (_) | |  __/ (__| |_\__ \
 |_|   |_|  \___// |\___|\___|\__|___/
               |__/`;
---

<Layout title="Projects — Elvis Mao" description="Websites, events, tools, and experiments by Elvis Mao.">
	<main id="main" class="page-main projects-page">
		<header class="projects-heading">
			<h1><span class="sr-only">Projects</span><pre aria-hidden="true">{title}</pre></h1>
			<p>For people I'll never meet,<br />and people I'll never forget.</p>
			<nav class="projects-index" aria-label="Project categories">
				<a href="#featured">Featured</a>
				{categories.map(category => <a href={`#${category.id}`}>{category.name}</a>)}
			</nav>
		</header>
		<section class="work-featured" id="featured" aria-labelledby="featured-heading">
			<div class="work-section-heading"><h2 id="featured-heading">Featured</h2></div>
			<div class="work-featured-grid">{featured.map(project => <WorkCard project={project} featured />)}</div>
		</section>
		{
			categories.map(category => (
				<section class="work-collection" id={category.id} data-expanded="false" aria-labelledby={`${category.id}-heading`}>
					<div class="work-section-heading">
						<h2 id={`${category.id}-heading`}>{category.name}</h2>
						<button class="collection-toggle" type="button" aria-expanded="false" aria-controls={`${category.id}-grid`} data-total={category.projects.length}>
							Show all ({category.projects.length})
						</button>
					</div>
					<div class="work-collection-grid" id={`${category.id}-grid`}>
						{category.projects.map(project => (
							<WorkCard project={project} />
						))}
					</div>
				</section>
			))
		}
		<noscript>
			<style>
				.work-collection[data-expanded] .work-card:nth-child(n) {
					display: block;
				}
				.collection-toggle {
					display: none;
				}
			</style>
		</noscript>
		<div class="work-footer"><Footer newsletter ascii /></div>
	</main>
</Layout>
<script>
	import "../../scripts/work";
</script>
